# Copy this file to .env and provide your own server-side credentials.
# Never send keys through the browser or commit .env / secrets/.
PORT=8787
# Optional exact browser origin; when empty, Compose derives localhost:${PORT}.
PUBLIC_ORIGIN=
OLLAMA_API_KEY=
TYPESAFE_API_KEY=
# Optional alternative: mounted files under ./secrets/ for Docker.
OLLAMA_API_KEY_FILE=
TYPESAFE_API_KEY_FILE=
SIYUAN_URL=
# Optional browser-facing SiYuan URL. Empty uses the native siyuan:// link.
SIYUAN_PUBLIC_URL=
SIYUAN_TOKEN=
SIYUAN_TOKEN_FILE=
# Docker can reach a host-network SiYuan at http://host.docker.internal:6806
# Select a notebook and managed root in the panel before any publication.
# Empty by default; auto-collection remains disabled until enabled in the panel.
OMP_SESSIONS_DIR=./data/empty-sources
# Native Bun only: comma-separated absolute read-only acquisition directories.
OMP_ALLOWED_ROOTS=
