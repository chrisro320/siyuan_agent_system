# Copy this file to .env and provide your own server-side credentials.
# Never send keys through the browser or commit .env / secrets/.
PORT=8787
# Optional exact browser origin; when empty, Compose derives localhost:${PORT}.
PUBLIC_ORIGIN=
# Initial generation selection (used until a panel draft is saved and service restarted).
# Supported: openai-compatible (/chat/completions) or ollama (/api/chat).
GENERATION_PROTOCOL=openai-compatible
GENERATION_BASE_URL=http://127.0.0.1:7861/antigravity/v1
GENERATION_MODEL=gemini-3.7-flash-medium
# bearer requires a server-side key; none is allowed only on a literal loopback IP.
GENERATION_AUTH_MODE=bearer
# Pin the key to exactly this origin when the panel switches to a different endpoint.
# Empty binds it to GENERATION_BASE_URL's origin; remote bearer requires HTTPS.
GENERATION_API_KEY_ORIGIN=
GENERATION_API_KEY=
TYPESAFE_API_KEY=
# Optional alternative: mounted files under ./secrets/ for Docker.
GENERATION_API_KEY_FILE=
TYPESAFE_API_KEY_FILE=
SIYUAN_URL=
# Optional browser-facing SiYuan URL. Empty uses the native siyuan:// link.
SIYUAN_PUBLIC_URL=
SIYUAN_TOKEN=
SIYUAN_TOKEN_FILE=
# Docker can reach a host-network SiYuan at http://host.docker.internal:6806
# Select a notebook and managed root in the panel before any publication.
# Empty by default; auto-collection remains disabled until enabled in the panel.
OMP_SESSIONS_DIR=./data/empty-sources
# Native Bun only: comma-separated absolute read-only acquisition directories.
OMP_ALLOWED_ROOTS=
# OMP background publication and explicit search (POST /api/capture and /api/search).
# ADAPTER_TOKEN or ADAPTER_TOKEN_FILE (direct value wins) is the Bearer token;
# unset leaves both routes at 503 adapter_not_configured.
# ADAPTER_PROJECTS is a comma-separated projectId allowlist; empty or unset
# answers every adapter request with 403 project_not_allowed.
# These are server-side only; never expose them to the browser.
ADAPTER_TOKEN=
ADAPTER_TOKEN_FILE=
ADAPTER_PROJECTS=
